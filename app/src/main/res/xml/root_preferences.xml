<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Status group: accessibility service state + setup guide.
         Row order follows the approved MIUIX mock (service state first). -->
    <io.github.lumiagg.gestureevo.settings.ui.HomeEntryPreference
        android:icon="@drawable/icon_service"
        android:key="preferenceService"
        app:miuixGlyphColor="@color/miuix_tile_green_fg"
        app:miuixTileColor="@color/miuix_tile_green_bg"
        android:summary="@string/settings_accessibility_service_label"
        android:title="@string/settings_accessibility_off" />

    <io.github.lumiagg.gestureevo.settings.ui.HomeEntryPreference
        android:icon="@drawable/baseline_check_24"
        android:key="preferenceSettingsGuide"
        app:miuixGlyphColor="@color/miuix_tile_blue_fg"
        app:miuixTileColor="@color/miuix_tile_blue_bg"
        android:summary="@string/guide_entry_summary"
        android:title="@string/guide_title" />

    <!-- Main entries group. -->
    <io.github.lumiagg.gestureevo.settings.ui.HomeEntryPreference
        android:icon="@drawable/baseline_gesture_24"
        android:key="preferenceConfigTrigger"
        app:miuixGlyphColor="@color/miuix_tile_orange_fg"
        app:miuixTileColor="@color/miuix_tile_orange_bg"
        android:title="@string/settings_gesture_title" />

    <io.github.lumiagg.gestureevo.settings.ui.HomeEntryPreference
        android:icon="@drawable/baseline_pie_chart_24"
        android:key="preferenceActionView"
        app:miuixGlyphColor="@color/miuix_tile_purple_fg"
        app:miuixTileColor="@color/miuix_tile_purple_bg"
        android:title="@string/action_view_settings_title" />

    <io.github.lumiagg.gestureevo.settings.ui.HomeEntryPreference
        android:icon="@drawable/baseline_auto_awesome_24"
        android:key="preferenceAppearance"
        app:miuixGlyphColor="@color/miuix_tile_pink_fg"
        app:miuixTileColor="@color/miuix_tile_pink_bg"
        android:title="@string/appearance_settings_title" />

    <io.github.lumiagg.gestureevo.settings.ui.HomeEntryPreference
        android:icon="@drawable/outline_center_focus_weak_24"
        android:key="preferenceInspire"
        app:miuixGlyphColor="@color/miuix_tile_teal_fg"
        app:miuixTileColor="@color/miuix_tile_teal_bg"
        android:title="@string/settings_features_title" />

    <io.github.lumiagg.gestureevo.settings.ui.HomeEntryPreference
        android:icon="@drawable/search_24px"
        android:key="preferenceSearch"
        app:miuixGlyphColor="@color/miuix_tile_blue_fg"
        app:miuixTileColor="@color/miuix_tile_blue_bg"
        android:title="@string/search_engine_settings_title" />

    <io.github.lumiagg.gestureevo.settings.ui.HomeEntryPreference
        android:icon="@drawable/ic_little_window"
        android:key="preferenceFreeform"
        app:miuixGlyphColor="@color/miuix_tile_cyan_fg"
        app:miuixTileColor="@color/miuix_tile_cyan_bg"
        android:title="@string/freeform_settings_title" />

    <!-- Secondary entries group. -->
    <io.github.lumiagg.gestureevo.settings.ui.HomeEntryPreference
        android:icon="@drawable/baseline_save_24"
        android:key="preferenceData"
        app:miuixGlyphColor="@color/miuix_tile_indigo_fg"
        app:miuixTileColor="@color/miuix_tile_indigo_bg"
        android:title="@string/data_backup_title" />

    <io.github.lumiagg.gestureevo.settings.ui.HomeEntryPreference
        android:icon="@drawable/ic_baseline_insert_link_24"
        android:key="preferenceExternalAction"
        app:miuixGlyphColor="@color/miuix_tile_violet_fg"
        app:miuixTileColor="@color/miuix_tile_violet_bg"
        android:title="@string/external_action_settings_title" />

    <io.github.lumiagg.gestureevo.settings.ui.HomeEntryPreference
        android:icon="@drawable/icon_lock"
        android:key="preferenceBackgroundStability"
        app:miuixGlyphColor="@color/miuix_tile_lime_fg"
        app:miuixTileColor="@color/miuix_tile_lime_bg"
        android:title="@string/background_stability_title" />

    <io.github.lumiagg.gestureevo.settings.ui.HomeEntryPreference
        android:icon="@drawable/baseline_info_24"
        android:key="preferenceAbout"
        app:miuixGlyphColor="@color/miuix_tile_gray_fg"
        app:miuixTileColor="@color/miuix_tile_gray_bg"
        android:title="@string/settings_about_title" />


    <!--    <Preference-->
    <!--        android:icon="@drawable/icon_adb"-->
    <!--        android:key="preferenceGeek"-->
    <!--        android:title="高级权限" />-->

</PreferenceScreen>
