<?xml version="1.0" encoding="utf-8"?>
<!-- Settings-home card segment: last row of a group (bottom corners). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/miuix_ripple">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" />
            <corners
                android:topLeftRadius="0dp"
                android:topRightRadius="0dp"
                android:bottomLeftRadius="@dimen/miuix_card_radius"
                android:bottomRightRadius="@dimen/miuix_card_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/miuix_card" />
            <corners
                android:topLeftRadius="0dp"
                android:topRightRadius="0dp"
                android:bottomLeftRadius="@dimen/miuix_card_radius"
                android:bottomRightRadius="@dimen/miuix_card_radius" />
        </shape>
    </item>
</ripple>
