<?xml version="1.0" encoding="utf-8"?>
<!-- MIUIX back affordance: chevron inside a white circle on settings pages. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <size android:width="40dp" android:height="40dp" />
            <solid android:color="@color/miuix_card" />
        </shape>
    </item>
    <item
        android:width="20dp"
        android:height="20dp"
        android:drawable="@drawable/ic_chevron_left_miuix"
        android:gravity="center" />
</layer-list>
