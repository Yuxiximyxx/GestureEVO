<?xml version="1.0" encoding="utf-8"?>
<!-- Settings-home card segment: middle row of a group (divider only). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/miuix_ripple">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/miuix_card" />
                </shape>
            </item>
            <item
                android:height="1px"
                android:left="68dp"
                android:right="16dp"
                android:gravity="bottom">
                <shape android:shape="rectangle">
                    <solid android:color="@color/miuix_divider" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
