<?xml version="1.0" encoding="utf-8"?>
<!-- HyperOS-style switch thumb: plain white circle with a hairline edge. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <size android:width="28dp" android:height="28dp" />
            <solid android:color="@color/miuix_switch_thumb" />
            <stroke android:width="1dp" android:color="@color/miuix_switch_thumb_stroke" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <size android:width="28dp" android:height="28dp" />
            <solid android:color="@color/miuix_switch_thumb" />
            <stroke android:width="1dp" android:color="@color/miuix_switch_thumb_stroke" />
        </shape>
    </item>
</selector>
