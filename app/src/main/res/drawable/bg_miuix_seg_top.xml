<?xml version="1.0" encoding="utf-8"?>
<!-- Settings-home card segment: first row of a group (top corners + divider). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/miuix_ripple">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" />
            <corners
                android:topLeftRadius="@dimen/miuix_card_radius"
                android:topRightRadius="@dimen/miuix_card_radius"
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp" />
        </shape>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/miuix_card" />
                    <corners
                        android:topLeftRadius="@dimen/miuix_card_radius"
                        android:topRightRadius="@dimen/miuix_card_radius"
                        android:bottomLeftRadius="0dp"
                        android:bottomRightRadius="0dp" />
                </shape>
            </item>
            <item
                android:height="1px"
                android:left="68dp"
                android:right="16dp"
                android:gravity="bottom">
                <shape android:shape="rectangle">
                    <solid android:color="@color/miuix_divider" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
