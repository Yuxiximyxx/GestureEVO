<?xml version="1.0" encoding="utf-8"?>
<!--
  MIUIX design tokens (light) for the settings surfaces.
  Hand-imitated HyperOS/MIUIX visual language on the existing View stack:
  light-gray page, white grouped cards, blue accent, gray secondary text.
  Night counterparts live in values-night/miuix_colors.xml with the same names.
-->
